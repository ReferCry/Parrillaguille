<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Capa_Presentacion_Avalonia"
        x:Class="Capa_Presentacion_Avalonia.PedidoWindow"
        Title="Pedido" Width="960" Height="650"
        WindowStartupLocation="CenterScreen"
        Background="#FFF8E1">

  <DockPanel>
    <!-- Header -->
    <Border DockPanel.Dock="Top" Background="#1E88E5" Padding="16,10,16,10">
      <DockPanel>
        <Button x:Name="btnAtras" DockPanel.Dock="Left" Classes="nav-btn"
                Content="← Atrás" Background="#1565C0"/>
        <TextBlock x:Name="txtTitulo" Text="📝 Tomar Pedido"
                   FontSize="20" FontWeight="Bold" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- Panel de acciones (abajo del header, arriba del data grid) -->
    <Border DockPanel.Dock="Bottom" Background="#E3F2FD" Padding="12,10">
      <DockPanel>
        <!-- Total a la derecha -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Total: S/" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBlock x:Name="txtTotal" Text="0.00" FontSize="20" FontWeight="Bold" 
                     Foreground="#1565C0" VerticalAlignment="Center" MinWidth="80"/>
        </StackPanel>
        <!-- Botones de acción a la izquierda -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="btnAgregar" Content="➕ Agregar" Classes="nav-btn"
                  Background="#43A047"/>
          <Button x:Name="btnEliminar" Content="🗑️ Eliminar" Classes="nav-btn"
                  Background="#E53935"/>
          <Button x:Name="btnVenta" Content="💰 Venta" Classes="nav-btn"
                  Background="#FB8C00"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- DataGrid de items del pedido -->
    <Border DockPanel.Dock="Bottom" Margin="12,0,12,8">
      <DataGrid x:Name="dgDetalles" AutoGenerateColumns="False" IsReadOnly="True"
                x:DataType="local:DetalleItem"
                CanUserResizeColumns="True" CanUserSortColumns="False"
                GridLinesVisibility="Horizontal" BorderBrush="#BDBDBD" BorderThickness="1"
                Background="White" RowBackground="White"
                HeadersVisibility="Column" SelectionMode="Single">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
          <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/>
          <DataGridTextColumn Header="P. Unitario" Binding="{Binding PrecioUnitario}" Width="100"/>
          <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal}" Width="100"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- Contenido principal: 3 columnas -->
    <Grid ColumnDefinitions="*,*,160" Margin="12,12,12,4">

      <!-- Columna izquierda: Comidas -->
      <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="12"
              Margin="0,0,6,0" BorderBrush="#E0E0E0" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10">
            <TextBlock Text="🍖 Comidas" FontSize="16" FontWeight="Bold" Foreground="#D32F2F"/>

            <!-- Pollos a la Brasa -->
            <StackPanel Spacing="4">
              <TextBlock Text="Pollos a la Brasa" FontSize="12" FontWeight="SemiBold" Foreground="#616161"/>
              <DockPanel>
                <TextBlock Text="Cantidad:" DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <NumericUpDown x:Name="qtyPollos" Minimum="1" Maximum="99" Value="1" Width="60" DockPanel.Dock="Right"/>
                <ComboBox x:Name="cboPollos" HorizontalAlignment="Stretch" FontSize="12"/>
              </DockPanel>
            </StackPanel>

            <!-- Parrillas -->
            <StackPanel Spacing="4">
              <TextBlock Text="Parrillas" FontSize="12" FontWeight="SemiBold" Foreground="#616161"/>
              <DockPanel>
                <TextBlock Text="Cantidad:" DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <NumericUpDown x:Name="qtyParrillas" Minimum="1" Maximum="99" Value="1" Width="60" DockPanel.Dock="Right"/>
                <ComboBox x:Name="cboParrillas" HorizontalAlignment="Stretch" FontSize="12"/>
              </DockPanel>
            </StackPanel>

            <!-- Platos a la Carta -->
            <StackPanel Spacing="4">
              <TextBlock Text="Platos a la Carta" FontSize="12" FontWeight="SemiBold" Foreground="#616161"/>
              <DockPanel>
                <TextBlock Text="Cantidad:" DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <NumericUpDown x:Name="qtyPlatosCarta" Minimum="1" Maximum="99" Value="1" Width="60" DockPanel.Dock="Right"/>
                <ComboBox x:Name="cboPlatosCarta" HorizontalAlignment="Stretch" FontSize="12"/>
              </DockPanel>
            </StackPanel>

            <!-- Otros -->
            <StackPanel Spacing="4">
              <TextBlock Text="Otros" FontSize="12" FontWeight="SemiBold" Foreground="#616161"/>
              <DockPanel>
                <TextBlock Text="Cantidad:" DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <NumericUpDown x:Name="qtyOtros" Minimum="1" Maximum="99" Value="1" Width="60" DockPanel.Dock="Right"/>
                <ComboBox x:Name="cboOtros" HorizontalAlignment="Stretch" FontSize="12"/>
              </DockPanel>
            </StackPanel>

            <!-- Porciones y Guarniciones -->
            <StackPanel Spacing="4">
              <TextBlock Text="Porciones y Guarniciones" FontSize="12" FontWeight="SemiBold" Foreground="#616161"/>
              <DockPanel>
                <TextBlock Text="Cantidad:" DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <NumericUpDown x:Name="qtyPorciones" Minimum="1" Maximum="99" Value="1" Width="60" DockPanel.Dock="Right"/>
                <ComboBox x:Name="cboPorciones" HorizontalAlignment="Stretch" FontSize="12"/>
              </DockPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Columna centro: Bebidas -->
      <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="12"
              Margin="6,0,6,0" BorderBrush="#E0E0E0" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10">
            <TextBlock Text="🥤 Bebidas" FontSize="16" FontWeight="Bold" Foreground="#1E88E5"/>

            <!-- Gaseosas -->
            <StackPanel Spacing="4">
              <TextBlock Text="Gaseosas" FontSize="12" FontWeight="SemiBold" Foreground="#616161"/>
              <DockPanel>
                <TextBlock Text="Cantidad:" DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <NumericUpDown x:Name="qtyGaseosas" Minimum="1" Maximum="99" Value="1" Width="60" DockPanel.Dock="Right"/>
                <ComboBox x:Name="cboGaseosas" HorizontalAlignment="Stretch" FontSize="12"/>
              </DockPanel>
            </StackPanel>

            <!-- Infusiones -->
            <StackPanel Spacing="4">
              <TextBlock Text="Infusiones" FontSize="12" FontWeight="SemiBold" Foreground="#616161"/>
              <DockPanel>
                <TextBlock Text="Cantidad:" DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <NumericUpDown x:Name="qtyInfusiones" Minimum="1" Maximum="99" Value="1" Width="60" DockPanel.Dock="Right"/>
                <ComboBox x:Name="cboInfusiones" HorizontalAlignment="Stretch" FontSize="12"/>
              </DockPanel>
            </StackPanel>

            <!-- Refrescos -->
            <StackPanel Spacing="4">
              <TextBlock Text="Refrescos" FontSize="12" FontWeight="SemiBold" Foreground="#616161"/>
              <DockPanel>
                <TextBlock Text="Cantidad:" DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <NumericUpDown x:Name="qtyRefrescos" Minimum="1" Maximum="99" Value="1" Width="60" DockPanel.Dock="Right"/>
                <ComboBox x:Name="cboRefrescos" HorizontalAlignment="Stretch" FontSize="12"/>
              </DockPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Columna derecha: Resumen rápido -->
      <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="12"
              Margin="6,0,0,0" BorderBrush="#E0E0E0" BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock Text="📋 Resumen" FontSize="14" FontWeight="Bold" Foreground="#424242"/>
          <Separator Background="#E0E0E0"/>
          <TextBlock x:Name="txtResumen" Text="Sin items agregados" FontSize="12" 
                     TextWrapping="Wrap" Foreground="#757575"/>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>

</Window>
